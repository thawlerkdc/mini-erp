# Ambiente de producao (nao versionar o .env.production real)
APP_ENV=production
FLASK_ENV=production

# Gere uma chave propria para producao
SECRET_KEY=change-me-production-secret-key

# Banco oficial de producao (escolha uma das opcoes)
DATABASE_URL=postgresql://user:password@host:5432/mini_erp_prod
# SUPABASE_DB_URL=postgresql://user:password@host:5432/postgres

# Pooler IPv4 do Supabase (recomendado para Render free)
# PGHOST=aws-1-us-west-2.pooler.supabase.com
# PGPORT=5432
# PGDATABASE=postgres
# PGUSER=postgres.lfbosnucnokjjluotoup
# PGPASSWORD=sua-senha-do-supabase

# CORS (origens separadas por virgula)
# CORS_ALLOWED_ORIGINS=https://seu-app.onrender.com,http://localhost:5000

# Endpoint /test-db (opcional, mas recomendado)
# TEST_DB_TOKEN=token_forte_para_diagnostico

# Envio de e-mails em producao (Render sem SMTP): usar Resend API
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev
EMAIL_DELIVERY_MODE=resend_only

# Opcional para dados locais persistentes
# DATA_DIR=./data-prod
